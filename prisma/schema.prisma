generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Administrator")
  createdAt DateTime @default(now())
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  position  String
  bio       String?
  image     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Program {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String   @default("BookOpen")
  topics      String[]
  order       Int      @default(0)
  active      Boolean  @default(true)
}

model DailyRoutine {
  id          Int      @id @default(autoincrement())
  time        String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Gallery {
  id        String   @id @default(cuid())
  image     String
  caption   String?
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  image       String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default("main")
  heroLocation   String
  heroTitle      String
  heroSubtitle   String
  heroDescription String
  heroImage      String?  @default("")
  aboutTitle     String
  aboutText      String
  featuresTitle  String
  programsTitle  String
  teachersTitle  String
  galleryTitle   String
  contactTitle   String
  logo           String   @default("")
  aboutImage     String   @default("")
  stats          Json
  updatedAt      DateTime @updatedAt
}

model Contact {
  id        String   @id @default(cuid())
  address   String
  phone     String
  instagram String
  mapUrl    String?
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String
  message   String
  answers   Json     @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FormConfig {
  id             String      @id @default("main")
  title          String      @default("Бизге жазыңыз")
  subtitle       String      @default("Суроолоруңузга жооп беребиз")
  buttonText     String      @default("Кабар жөнөтүү")
  successMessage String      @default("Кабарыңыз жөнөтүлдү. Жакында байланышабыз!")
  fields         FormField[]
  updatedAt      DateTime    @updatedAt
}

model FormField {
  id       String   @id @default(cuid())
  label    String
  name     String   @unique
  type     String
  required Boolean  @default(false)
  order    Int      @default(0)
  configId String   @default("main")
  config   FormConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
}
