'use client';
import { Menu, X } from 'lucide-react'; import Image from 'next/image'; import { useState } from 'react';
const links=[['Биз жөнүндө','#about'],['Программалар','#programs'],['Устаздар','#teachers'],['Галерея','#gallery'],['Байланыш','#contact']];
export function Navbar(){const [open,setOpen]=useState(false); return <header className="absolute z-20 w-full text-white"><div className="container-x flex h-24 items-center justify-between"><a href="#top" className="flex items-center gap-3"><span className="relative h-12 w-12 overflow-hidden rounded-full border border-gold/70"><Image src="/images/logo.jpeg" alt="Quran Academy" fill className="object-cover" sizes="44px" /></span><span><b className="block text-sm tracking-[.16em]">QURAN ACADEMY</b><small className="text-[10px] text-white/70">Бишкек · Кыргызстан</small></span></a><nav className="hidden gap-7 lg:flex">{links.map(([t,h])=><a key={h} className="text-sm text-white/85 hover:text-gold" href={h}>{t}</a>)}</nav><a href="#contact" className="hidden rounded-full bg-gold px-5 py-2.5 text-sm font-bold text-navy md:block">Катталуу</a><button aria-label="Меню" className="lg:hidden" onClick={()=>setOpen(!open)}>{open?<X/>:<Menu/>}</button></div>{open&&<div className="glass border-0 px-6 pb-6 lg:hidden">{links.map(([t,h])=><a key={h} onClick={()=>setOpen(false)} className="block border-b border-white/10 py-3" href={h}>{t}</a>)}</div>}</header>}
